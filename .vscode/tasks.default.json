{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "Build app",
        "type": "shell",
        "command": "uv run west build ${input:target} ${input:shield}",
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "group": "build",
        "presentation": {
            "echo": true,
            "reveal": "always",
            "focus": false,
            "panel": "shared"
        },
        "problemMatcher": []
    },
    {
        "label": "Flash app",
        "type": "shell",
        "command": "uv run west flash",
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "presentation": {
            "echo": true,
            "reveal": "always",
            "focus": false,
            "panel": "shared"
        },
        "problemMatcher": []
    },
    {
        "label": "Clean Build Directory",
        "type": "shell",
        "command": "uv run west build -t pristine ${input:target}",
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "presentation": {
            "echo": true,
            "reveal": "always",
            "focus": false,
            "panel": "shared"
        },
        "problemMatcher": []
    },
    {
        "label": "Build and Flash app",
        "dependsOn": [
            "Build app",
            "Flash app"
        ],
        "dependsOrder": "sequence",
        "problemMatcher": [],
        "group": {
            "kind": "build",
            "isDefault": true
        }
    },
    {
        "label": "Debug server",
        "type": "shell",
        "command": "uv run west debugserver -r jlink",
        "problemMatcher": {
            "pattern": {
                "regexp":
                    "^(Info |Warn |Error):(.*)$",
                "severity": 1,
                "message": 2
            },
            "background": {
                "activeOnStart": true,
                "beginsPattern": ".*reset after flashing requested.*",
                "endsPattern": ".*J-Link GDB server running on port 2331.*",
            },
        },
        "isBackground": true,
        "runOptions": {
            "instanceLimit": 1,
            "instancePolicy": "terminateOldest"
        },
        "presentation": {
            "reveal": "silent",
            "close": true,
        },
    },
    {
        "label": "Stop Debugserver",
        "type": "process",
        "command": "${command:workbench.action.tasks.terminate}",
    },
],
  "inputs": [
    {
      "id": "target",
      "type": "promptString",
      "description": "Build target",
      "default": "app"
    },
    {
      "id": "shield",
      "type": "pickString",
      "description": "LCD shield",
      "default": "",
      "options": [
        "",
        "--shield=adafruit_2_8_tft_touch_v2"
      ]
    }
  ]
}